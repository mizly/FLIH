# Copy this file to scripts/.env and replace the API key.
ROBOT_WS_URL=wss://flih.onrender.com/ws/robot
ROBOT_CAMERA_WS_URL=wss://flih.onrender.com/ws/camera
ROBOT_LIDAR_WS_URL=wss://flih.onrender.com/ws/lidar
ROBOT_API_KEY=the-same-value-as-render

# Optional Huawei OMNI/Yibu perception, called by backend/lidar_stream.py on the Jetson.
YIBU_API_KEY=
YIBU_BASE_URL=https://yibuapi.com/v1
YIBU_MODEL=qwen3.5-omni-plus
ROBOT_OMNI_INTERVAL=5
